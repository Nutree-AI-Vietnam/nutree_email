RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=alex.nguyen@nutreeai.com
EMAIL_FROM_NAME=Alex Nguyen
EMAIL_SUBJECT=Newsletter
EMAIL_TEMPLATE=welcome.html

# Deliverability: List-Unsubscribe header (Gmail/Yahoo bulk-sender requirement).
# Set EMAIL_LIST_UNSUBSCRIBE_URL to a one-click HTTPS endpoint to enable
# RFC 8058 one-click unsubscribe; otherwise a mailto fallback is used.
EMAIL_LIST_UNSUBSCRIBE_URL=
EMAIL_LIST_UNSUBSCRIBE_MAILTO=unsubscribe@nutreeai.com
